# General
## NODE_ENV: development | production
NODE_ENV=production
## Stage: dev | alpha | beta | production | internal
STAGE=dev

# Debug
DEBUG=true

# Webhooks
# BUNDESTAGIO_SERVER_URL=

# JWT
AUTH_JWT_SECRET=CHANGE_ME
AUTH_JWT_TTL=1m
AUTH_JWT_REFRESH_TTL=5m
JWT_BACKWARD_COMPATIBILITY=true

# SMS
SMS_VERIFICATION=false
SMS_PROVIDER_KEY=
# SMS_VERIFICATION_NEW_USER_DELAY=
# SMS_SIMULATE=true

# GraphQL
GRAPHIQL=true

# Apollo Engine
ENGINE_API_KEY=
ENGINE_DEBUG_MODE=

# Voyager
VOYAGER=true

# Logging
## ( LEVEL: [error|warn|info|verbose|debug|silly] )
LOGGING_CONSOLE=silly
LOGGING_FILE=silly
LOGGING_MONGO=silly
LOGGING_DISCORD=silly
LOGGING_DISCORD_TOKEN=
LOGGING_DISCORD_WEBHOOK=https://discordapp.com/api/webhooks/...

# RemoveMe
SECRET_KEY=CHANGE_ME

# Enable express status
EXPRESS_STATUS=true

# Firebase (Push Service)
CLOUD_MESSAGING_API_TOKEN=
APPLICATION_BUNDLE_IDENTIFIER=
# Donations (In-App-Spenden, src/donations) – siehe docs/DONATIONS.md
## Kill-Switch: false = App zeigt nur Finanzierungsstand + Bankverbindung
DONATIONS_ENABLED=false
## Stripe: im Dev/Internal-Betrieb ausschließlich Testmodus-Schlüssel (rk_test_/pk_test_)
## Secret: Restricted Key, niemals im Client
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
## Webhook-Signatur (lokal aus `stripe listen --forward-to localhost:3000/donations/v1/stripe-webhook`)
STRIPE_WEBHOOK_SECRET=
## Product „Monatliche Spende an DEMOCRACY" (prod_…)
STRIPE_DONATION_PRODUCT_ID=
## Customer-Portal-Login-Link (https://billing.stripe.com/p/login/…)
STRIPE_PORTAL_LOGIN_URL=
## Eigene Portal-Konfiguration (bpc_…) für Verwaltungs-Sessions aus der App; Standardportal bleibt unberührt.
## Pflicht bei DONATIONS_ENABLED=true.
STRIPE_PORTAL_CONFIGURATION_ID=
## Anzeigename im Zahlungsdialog (Apple Pay/Google Pay/PaymentSheet)
DONATION_MERCHANT_DISPLAY_NAME="DEMOCRACY Deutschland e.V."
## Beträge in Cent
DONATION_MIN_CENTS=500
DONATION_MAX_CENTS=100000
DONATION_PRESETS_ONE_TIME=1000,2500,5000,10000
DONATION_PRESETS_MONTHLY=500,1000,1500,2500
DONATION_DEFAULT_INTERVAL=monthly
## Stripe-Zahlungsprofil (pmc_…), steuert die Zahlungsarten im Dashboard.
## Muss das Standardprofil des Kontos sein (App-SDK und Abos nutzen immer das Standardprofil).
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=
## Gebührenübernahme (Stripe-Tarif DE, Prozent bzw. Cent)
DONATION_FEE_CARD_PCT=1.5
DONATION_FEE_CARD_FIXED_CENTS=25
DONATION_FEE_SEPA_FIXED_CENTS=35
DONATION_FEE_BILLING_PCT=0.7
## Optional: Bankverbindung und Rechtslinks für /config (Standardwerte im Code)
# DONATION_BANK_HOLDER="DEMOCRACY Deutschland e.V."
# DONATION_BANK_IBAN="DE83 2605 0001 0056 1290 91"
# DONATION_BANK_BIC=NOLADE21GOE
# DONATION_PRIVACY_URL=https://democracy-deutschland.de/datenschutz/
# DONATION_NONPROFIT_PROOF_URL=https://www.democracy-deutschland.de/files/download/Gemeinnutzigkeit_DEMOCRACY.pdf
# DONATION_SIMPLIFIED_RECEIPT_URL=https://www.democracy-deutschland.de/files/download/Vereinfachter_Zuwendungsnachweis.pdf
## Angaben für Spendenbestätigungen (vereinfachter Zuwendungsnachweis). Freistellung im Format z. B.
## "Freistellungsbescheid des Finanzamts Göttingen, StNr. …, vom TT.MM.JJJJ" – vor Livegang Pflicht (O2)
# DONATION_RECEIPT_ORGANIZATION="DEMOCRACY Deutschland e.V."
# DONATION_RECEIPT_PURPOSE="Förderung des demokratischen Staatswesens sowie der Volks- und Berufsbildung"
DONATION_RECEIPT_EXEMPTION=
## Bestätigungs-E-Mails (nodemailer). Pflicht bei DONATIONS_ENABLED=true (sonst gingen Bestätigungen verloren).
SMTP_URL=
DONATION_MAIL_FROM="DEMOCRACY Spenden <spenden@democracy-deutschland.de>"
DONATION_MAIL_REPLY_TO=spenden@democracy-deutschland.de
## Nur Stripe-Testmodus (z. B. internal): Mails ausschließlich an diese Domains/Adressen, kommagetrennt.
## Leer = im Testmodus keine Mails. Lokal mit Mailpit z. B. „example.org".
DONATION_TEST_MAIL_ALLOWLIST=
